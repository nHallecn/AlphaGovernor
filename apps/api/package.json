{
  "name": "@alphagovernor/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@alphagovernor/agent-core": "workspace:*",
    "@alphagovernor/alpaca": "workspace:*",
    "@alphagovernor/config": "workspace:*",
    "@alphagovernor/contracts": "workspace:*",
    "@alphagovernor/db": "workspace:*",
    "@alphagovernor/indicators": "workspace:*",
    "@alphagovernor/risk-core": "workspace:*",
    "@fastify/cors": "11.2.0",
    "@fastify/rate-limit": "10.3.0",
    "bullmq": "6.2.2",
    "dotenv": "17.2.3",
    "fastify": "5.12.1",
    "ioredis": "5.8.2",
    "pino": "10.1.0",
    "zod": "4.1.12"
  },
  "devDependencies": { "@types/node": "24.10.0", "tsx": "4.21.0", "typescript": "5.9.3", "vitest": "4.1.11" }
}
