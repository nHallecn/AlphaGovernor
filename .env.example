# Core
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alphagovernor
REDIS_URL=redis://localhost:6379
OPERATOR_TOKEN=change-me-before-deploying
DEMO_MODE=true

# Alpaca — PAPER ONLY. The API refuses unsafe configuration.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex
ALPACA_MCP_ENABLED=false
ALPACA_TOOLSETS=account,assets,stock-data,news

# AI — optional; invalid/unavailable output always becomes ABSTAIN.
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-5.5

# Trading / orchestration
DECISION_INTERVAL_MINUTES=5
DEFAULT_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,AMD
MIN_PROPOSAL_CONFIDENCE=0.65
MIN_CASH_RESERVE_PCT=10
RISK_PER_TRADE_PCT=0.5
MAX_POSITION_PCT=10
MAX_AGENT_ALLOCATION_PCT=35
MAX_DAILY_LOSS_PCT=2
MAX_DRAWDOWN_PCT=5
MAX_OPEN_POSITIONS=8
MAX_ORDERS_PER_CYCLE=3
