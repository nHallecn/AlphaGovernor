generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentType {
  MOMENTUM
  MEAN_REVERSION
  NEWS
  DEFENSIVE
}
enum AgentStatus {
  ACTIVE
  PROBATION
  SUSPENDED
  DISABLED
}
enum MarketRegime {
  BULL_TREND
  BEAR_TREND
  RANGE
  HIGH_VOL
  LOW_VOL
  EVENT_SHOCK
}
enum ProposalAction {
  BUY
  SELL
  EXIT
  HOLD
}
enum RiskDecisionType {
  APPROVE
  RESIZE
  REJECT
}
enum DecisionCycleStatus {
  CREATED
  DATA_READY
  AGENTS_COMPLETE
  GOVERNED
  RISK_REVIEWED
  EXECUTED
  COMPLETED
  FAILED
  CANCELLED
}
enum DecisionMode {
  LIVE_PAPER
  REPLAY
}
enum ReplayStatus {
  CREATED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  STOPPED
}
enum SystemTradingStatus {
  RUNNING
  PAUSED
  RISK_OFF
}

model Agent {
  id          String      @id @default(uuid()) @db.Uuid
  type        AgentType   @unique
  name        String
  status      AgentStatus @default(ACTIVE)
  description String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  metrics     AgentMetric[]
  allocations AgentAllocation[]
  proposals   TradeProposal[]
  auditEvents AuditEvent[]
}

model AgentMetric {
  id               String   @id @default(uuid()) @db.Uuid
  agentId          String   @db.Uuid
  timestamp        DateTime @default(now())
  trustScore       Decimal  @db.Decimal(6, 3)
  pnlPct           Decimal  @db.Decimal(9, 4)
  winRate          Decimal  @db.Decimal(6, 5)
  maxDrawdownPct   Decimal  @db.Decimal(9, 4)
  calibrationScore Decimal  @db.Decimal(6, 5)
  regimeScore      Decimal  @db.Decimal(6, 5)
  executionQuality Decimal  @db.Decimal(6, 5)
  sampleSize       Int      @default(0)
  source           String   @default("REPLAY")
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  @@index([agentId, timestamp])
}

model AgentAllocation {
  id             String   @id @default(uuid()) @db.Uuid
  cycleId        String   @db.Uuid
  agentId        String   @db.Uuid
  weight         Decimal  @db.Decimal(7, 6)
  maxNotionalUsd Decimal  @db.Decimal(18, 4)
  reason         String
  createdAt      DateTime @default(now())
  cycle          DecisionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  @@unique([cycleId, agentId])
}

model WatchlistItem {
  id       String @id @default(uuid()) @db.Uuid
  symbol   String @unique
  enabled  Boolean @default(true)
  priority Int @default(0)
  tags     String[]
}

model MarketBar {
  id        String   @id @default(uuid()) @db.Uuid
  symbol    String
  timeframe String
  timestamp DateTime
  open      Decimal @db.Decimal(18, 6)
  high      Decimal @db.Decimal(18, 6)
  low       Decimal @db.Decimal(18, 6)
  close     Decimal @db.Decimal(18, 6)
  volume    BigInt
  vwap      Decimal? @db.Decimal(18, 6)
  source    String
  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timestamp])
}

model IndicatorSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  symbol           String
  timestamp        DateTime
  ema20            Decimal? @db.Decimal(18, 6)
  ema50            Decimal? @db.Decimal(18, 6)
  rsi14            Decimal? @db.Decimal(10, 6)
  atr14            Decimal? @db.Decimal(18, 6)
  realizedVol20    Decimal? @db.Decimal(12, 8)
  zScore20         Decimal? @db.Decimal(12, 8)
  volumeRatio      Decimal? @db.Decimal(12, 8)
  relativeStrength Decimal? @db.Decimal(12, 8)
  @@index([symbol, timestamp])
}

model MarketRegimeSnapshot {
  id          String       @id @default(uuid()) @db.Uuid
  timestamp   DateTime     @default(now())
  regime      MarketRegime
  confidence  Decimal      @db.Decimal(6, 5)
  metricsJson Json
  explanation String
  cycles      DecisionCycle[]
}

model NewsEvent {
  id          String   @id @default(uuid()) @db.Uuid
  providerId  String?  @unique
  headline    String
  summary     String
  source      String
  url         String
  symbols     String[]
  publishedAt DateTime
  sentiment   String?
  materiality Decimal? @db.Decimal(6, 5)
  rawJson     Json?
  @@index([publishedAt])
}

model DecisionCycle {
  id               String              @id @default(uuid()) @db.Uuid
  mode             DecisionMode
  status           DecisionCycleStatus @default(CREATED)
  startedAt        DateTime            @default(now())
  completedAt      DateTime?
  regimeSnapshotId String?             @db.Uuid
  dataAsOf         DateTime?
  error            String?
  correlationId    String              @unique
  regimeSnapshot   MarketRegimeSnapshot? @relation(fields: [regimeSnapshotId], references: [id])
  proposals        TradeProposal[]
  allocations      AgentAllocation[]
  governorDecision GovernorDecision?
  auditEvents      AuditEvent[]
  @@index([startedAt])
}

model TradeProposal {
  id                   String         @id @default(uuid()) @db.Uuid
  cycleId              String         @db.Uuid
  agentId              String         @db.Uuid
  symbol               String
  action               ProposalAction
  confidence           Decimal        @db.Decimal(6, 5)
  requestedNotionalUsd Decimal        @db.Decimal(18, 4)
  stopPrice            Decimal?       @db.Decimal(18, 6)
  takeProfitPrice      Decimal?       @db.Decimal(18, 6)
  horizonMinutes       Int
  thesis               String
  invalidation         String
  evidenceJson         Json
  dataAsOf             DateTime
  createdAt            DateTime       @default(now())
  cycle                DecisionCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  agent                Agent          @relation(fields: [agentId], references: [id])
  riskDecision         RiskDecision?
  orders               ExecutionOrder[]
  auditEvents          AuditEvent[]
  @@index([cycleId, agentId])
}

model GovernorDecision {
  id                      String   @id @default(uuid()) @db.Uuid
  cycleId                 String   @unique @db.Uuid
  selectedProposalIdsJson Json
  rejectedProposalIdsJson Json
  scoresJson              Json
  rationale               String
  createdAt               DateTime @default(now())
  cycle                   DecisionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
}

model RiskDecision {
  id                   String           @id @default(uuid()) @db.Uuid
  proposalId           String           @unique @db.Uuid
  decision             RiskDecisionType
  approvedNotionalUsd  Decimal          @db.Decimal(18, 4)
  approvedQty          Decimal?         @db.Decimal(18, 8)
  stopPrice            Decimal?         @db.Decimal(18, 6)
  takeProfitPrice      Decimal?         @db.Decimal(18, 6)
  checksJson           Json
  rejectionCodesJson   Json
  createdAt            DateTime         @default(now())
  proposal             TradeProposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  orders               ExecutionOrder[]
}

model ExecutionOrder {
  id                  String   @id @default(uuid()) @db.Uuid
  proposalId          String   @db.Uuid
  riskDecisionId      String   @db.Uuid
  alpacaOrderId       String?
  clientOrderId       String   @unique
  symbol              String
  side                String
  type                String
  tif                 String
  requestedQty        Decimal? @db.Decimal(18, 8)
  requestedNotional   Decimal? @db.Decimal(18, 4)
  status              String
  filledQty           Decimal  @default(0) @db.Decimal(18, 8)
  filledAvgPrice      Decimal? @db.Decimal(18, 6)
  submittedAt         DateTime?
  updatedAt           DateTime @updatedAt
  lastAlpacaRequestId String?
  proposal            TradeProposal @relation(fields: [proposalId], references: [id])
  riskDecision        RiskDecision @relation(fields: [riskDecisionId], references: [id])
  auditEvents         AuditEvent[]
  @@index([status])
}

model PositionSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  timestamp       DateTime @default(now())
  symbol          String
  qty             Decimal  @db.Decimal(18, 8)
  avgEntryPrice   Decimal  @db.Decimal(18, 6)
  marketValue     Decimal  @db.Decimal(18, 4)
  costBasis       Decimal  @db.Decimal(18, 4)
  unrealizedPl    Decimal  @db.Decimal(18, 4)
  unrealizedPlPct Decimal  @db.Decimal(10, 6)
  @@index([symbol, timestamp])
}

model AccountSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  timestamp        DateTime @default(now())
  equity           Decimal  @db.Decimal(18, 4)
  cash             Decimal  @db.Decimal(18, 4)
  buyingPower      Decimal  @db.Decimal(18, 4)
  portfolioValue   Decimal  @db.Decimal(18, 4)
  daytradeCount    Int
  tradingBlocked   Boolean
  @@index([timestamp])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  cycleId    String?  @db.Uuid
  agentId    String?  @db.Uuid
  proposalId String?  @db.Uuid
  orderId    String?  @db.Uuid
  eventType  String
  severity   String
  message    String
  payloadJson Json?
  createdAt  DateTime @default(now())
  cycle      DecisionCycle? @relation(fields: [cycleId], references: [id])
  agent      Agent? @relation(fields: [agentId], references: [id])
  proposal   TradeProposal? @relation(fields: [proposalId], references: [id])
  order      ExecutionOrder? @relation(fields: [orderId], references: [id])
  @@index([createdAt])
  @@index([eventType])
}

model RiskProfile {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  active    Boolean  @default(false)
  limitsJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReplayRun {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  status      ReplayStatus @default(CREATED)
  startTime   DateTime
  endTime     DateTime
  speed       Int
  symbols     String[]
  seed        Int
  createdAt   DateTime     @default(now())
  completedAt DateTime?
  summaryJson Json?
}

model SystemState {
  id              String              @id
  tradingStatus   SystemTradingStatus @default(PAUSED)
  paperMode       Boolean             @default(true)
  lastProviderOkAt DateTime?
  updatedAt       DateTime            @updatedAt
}
