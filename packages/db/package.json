{
  "name": "@alphagovernor/db",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm typecheck",
    "test": "vitest run --passWithNoTests",
    "migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": { "@prisma/client": "6.19.3" },
  "devDependencies": { "prisma": "6.19.3", "tsx": "4.21.0", "typescript": "7.0.2", "vitest": "4.1.11" },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
