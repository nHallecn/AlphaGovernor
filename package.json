{
  "name": "alphagovernor",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @alphagovernor/db generate",
    "db:migrate": "pnpm --filter @alphagovernor/db migrate",
    "db:seed": "pnpm --filter @alphagovernor/db seed",
    "db:studio": "pnpm --filter @alphagovernor/db studio"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
